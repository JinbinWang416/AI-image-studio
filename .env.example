# ============================================================================
#  门店贴纸图片自动生成智能体 —— 环境配置
#  复制本文件为 .env 后修改（.env 不要提交到版本库）
# ============================================================================

# ---------------------------------------------------------------- 服务商
# 可选：mock（离线模拟，无需 Key） / qwen（阿里百炼） / kling（快手可灵） / zhipu（智谱） / openai（房屋中介 6 图）
PROVIDER=mock

# ---------------------------------------------------------------- API Keys
# 阿里云百炼（首选）：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# 快手可灵（批量吞吐最优）：https://klingai.com/
KLING_API_KEY=

# 智谱（单价最低，但无负向提示词）：https://open.bigmodel.cn/
ZHIPU_API_KEY=

# OpenAI GPT Image（房屋中介“生成 6 张新图”）：https://platform.openai.com/api-keys
OPENAI_API_KEY=

# DeepSeek（可选：每张 OpenAI 房屋中介图在生成前优化一次中文提示词）
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_PROMPT_OPTIMIZER_ENABLED=true

# 覆盖默认端点 / 模型（一般不用填）
# BASE_URL=
# MODEL=

# ---------------------------------------------------------------- 调度
# 并发数。注意不要超过服务商限流：
#   阿里 qwen-image-3.0 = 20 次/分钟；3.0-pro = 5 次/分钟；2.0-pro/max = 2 次/分钟
#   快手 kling-v3 = 无 QPS 限制，并发 9
#   腾讯混元 = 默认并发 1
CONCURRENCY=4

# 每分钟请求上限（0 = 用服务商预置值；留空则自动套用）
# RPM_LIMIT=

# 失败重试次数与退避秒数
RETRY_MAX=3
# RETRY_BACKOFF=2,5,15

# 单次请求超时（秒）
TIMEOUT=120

# ---------------------------------------------------------------- 输出
# 输出根目录（默认 ./output）
# OUTPUT_ROOT=

# 文件名是否加时间戳前缀：
#   false → 01_水龙头.png                （推荐，检索友好；时间记在 _manifest.json）
#   true  → 20260918_164130_01_水龙头.png
TIMESTAMP_PREFIX=false

# 已存在的图片是否重新生成（false = 断点续跑时跳过）
OVERWRITE=false

# ---------------------------------------------------------------- 质检
# 生成后用 OCR 回读图上中文，与期望文本比对（需安装 rapidocr-onnxruntime）
QC_ENABLED=true
# 文字相似度阈值，低于此值判定为不合格并自动重生成
QC_MIN_SIMILARITY=0.80

# ---------------------------------------------------------------- 成本守卫
# 单次运行的最大调用次数，超出即停止（防止异常烧钱）
# 138 张 + 1.5 倍重试余量 ≈ 210，留些余量设 400
BUDGET_LIMIT=400

# ---------------------------------------------------------------- 其他
# 只做流程演练，不真正调用 API
DRY_RUN=false

# 模拟器参数（仅 PROVIDER=mock 时有效）
# MOCK_LATENCY=0.35      # 单张模拟耗时（秒）
# MOCK_FAIL_RATE=0       # 模拟失败率，如设 0.3 可测试重试逻辑
